# --- R ---
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Renviron

# --- renv ---
# renv.lock SÍ se versiona: es la promesa de reproducibilidad del informe.
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# --- Quarto ---
/.quarto/
informe/*_files/
informe/*.html
informe/*.docx

# --- Datos del investigador ---
# NUNCA se versionan datos reales de la encuesta.
#
# Las reglas van ANCLADAS a la raiz del repo. Sin la barra inicial, "datos/"
# se aplicaria a cualquier carpeta con ese nombre en cualquier nivel, e
# ignoraria las bases sinteticas de prueba en
# pkg/calibraqca/tests/testthat/datos/ — que si se versionan. Una excepcion
# con "!" no las rescataria: git no reabre un directorio ya excluido.
/datos/
/*.csv
/*.xlsx
*.sav
*.dta

# --- Notas de trabajo que no se publican ---
# Estrategia de comunicacion con terceros y lecciones internas. La parte
# tecnica de cada hallazgo si va en docs/.
/docs/local/

# --- Sistema ---
.DS_Store
*.log

**/*.quarto_ipynb

# --- Quarto: los renders se regeneran, no se versionan ---
informe/informe.html
informe/informe.docx

# Los renders que caen en la raiz (informe-calibrador-fsqca.*,
# guia-de-lectura-informe-fsqca.*). Anclados con la barra inicial para no
# tocar los .pdf de docs/referencias/, que si se versionan.
/*.html
/*.pdf
